<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/w_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAlignment="viewStart" />
        <TextView
            android:id="@+id/w_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFF4B266"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_fajr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:textColor="#FFC9D2EA"
        android:textSize="13sp"
        android:textAlignment="viewStart" />

    <TextView android:id="@+id/w_row0" style="@style/WidgetRow" />
    <TextView android:id="@+id/w_row1" style="@style/WidgetRow" />
    <TextView android:id="@+id/w_row2" style="@style/WidgetRow" />
    <TextView android:id="@+id/w_row3" style="@style/WidgetRow" />

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFF4B266"
        android:textSize="14sp"
        android:textAlignment="viewStart"
        android:visibility="gone" />
</LinearLayout>
