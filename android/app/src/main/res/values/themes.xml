<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
    </style>
    <style name="AlarmTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/alarm_bg</item>
        <item name="colorAccent">@color/icon_bg</item>
        <item name="android:windowBackground">@color/alarm_bg</item>
        <item name="android:statusBarColor">@color/alarm_bg</item>
        <item name="android:navigationBarColor">@color/alarm_bg</item>
    </style>
    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:background">@drawable/widget_row</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAlignment">viewStart</item>
    </style>
</resources>
